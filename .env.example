# ForgeQueue Environment Configuration Example

# API Configuration
API_PORT=8080
APP_ENV=development

# Authentication (Minimum 32 characters)
JWT_SECRET=forgequeue_development_secret_key_at_least_32_bytes_long!!
JWT_TTL=24h

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=forgequeue
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Transactional Outbox
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL=100ms
OUTBOX_STALE_CUTOFF=10s

# Worker Configuration
WORKER_CONCURRENCY=4
WORKER_HEARTBEAT_INTERVAL=3s
WORKER_MIN_IDLE_CLAIM_TIME=20s
WORKER_CLAIM_BATCH_SIZE=5
WORKER_EXECUTOR=docker

# Failure Recovery Janitor
JANITOR_INTERVAL=5s
JANITOR_STALE_THRESHOLD=15s
JANITOR_LEASE_GRACE=15s

# Frontend Web
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
