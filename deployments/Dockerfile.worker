# Build stage
FROM golang:1.22-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o /forgequeue-worker ./cmd/worker

# Final stage with Docker CLI
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata docker-cli

WORKDIR /app
COPY --from=builder /forgequeue-worker /app/forgequeue-worker

ENTRYPOINT ["/app/forgequeue-worker"]
